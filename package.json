{
  "name": "reservation-reminder",
  "version": "0.1.0",
  "private": true,
  "description": "Googleカレンダーの予約から前日18:00にリマインダー対象を判定し、送信をシミュレーションする（架空データ専用）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:safety": "vitest run test/safety",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply reservation-reminder --local"
  },
  "dependencies": {
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.2",
    "@cloudflare/workers-types": "5.20261014.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.0"
  }
}
